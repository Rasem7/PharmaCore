{
  "name": "pharmacore-electron",
  "version": "0.1.0",
  "private": true,
  "description": "PharmaCore Windows desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pharmacore.desktop",
    "productName": "PharmaCore",
    "files": ["main.js", "preload.js", { "from": "../../frontend/pharmacore-angular/dist/pharmacore-angular/browser", "to": "app" }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
